local function OnCharacterAdded(character)
    task.wait(0.6)

    local hum = character:WaitForChild("Humanoid", 5)
    if hum then hum.WalkSpeed = State.WalkSpeed end

    if State.InfJump  then StartInfJump() end
    if State.NoClip   then StartNoClip() end
    if State.Godmode  then StartGodmode() end

    -- Rescan remotes après respawn
    CollectRemotes = ScanRemotes()

    if State.ESPPlayers or State.ESPEggs or State.ESPItems then
        task.wait(0.3); BuildESP()
    end

    Notify("Respawn", "Tous les paramètres réappliqués.", 2)
end

