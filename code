-- ================================================
-- CONFIG — ŒUFS RARES À SURVEILLER
-- Ajoute ici les mots-clés exacts présents dans les noms d'objets du jeu
-- ================================================

local RARE_KEYWORDS = {
    "Eternal", "eternal", "ETERNAL",
    "Secret",  "secret",  "SECRET",
    "Mythic",  "mythic",  "MYTHIC",
    "Divine",  "divine",  "DIVINE",
    "Celestial","celestial",
    "Omega",   "omega",
    "Ultra",   "ultra",
    "Godly",   "godly",
}

local ALL_EGG_KEYWORDS = {
    "Egg", "egg", "EGG",
    "oeuf", "Oeuf",
}

-- ================================================
-- STATE
-- ================================================

local State = {
    AutoFarm      = false,
    SpawnAlert    = true,
    AutoTeleport  = true,   -- téléporte auto sur spawn rare
    FarmDelay     = 0.08,   -- délai entre chaque tentative (secondes)
    AlertSound    = true,
    EggType       = "All",
}

local KnownEggs   = {}  -- { [instance] = true } — évite les doublons d'alerte
local FarmThread  = nil
local WatchThread = nil

-- ================================================
-- UTILITAIRES
-- ================================================

local function GetHRP()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function TeleportTo(cf)
    local hrp = GetHRP()
    if hrp and cf then
        hrp.CFrame = CFrame.new(cf.Position + Vector3.new(0, 4, 0))
    end
end

local function MatchAny(name, keywords)
    for _, kw in ipairs(keywords) do
        if string.find(name, kw, 1, true) then return true end
    end
    return false
end

local function IsRare(name)
    return MatchAny(name, RARE_KEYWORDS)
end

local function IsEgg(name)
    return MatchAny(name, ALL_EGG_KEYWORDS)
end

local function GetPivot(obj)
    if obj:IsA("Model") then
        local ok, cf = pcall(function() return obj:GetPivot() end)
        if ok and cf then return cf end
        local p = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
        return p and p.CFrame or nil
    elseif obj:IsA("BasePart") then
        return obj.CFrame
    end
    return nil
end

-- ================================================
-- BYPASS — DÉTECTION DES REMOTEEVENTS DU JEU
-- Scan ReplicatedStorage pour trouver les events de collecte
-- ================================================

local function ScanRemotes()
    local remotes = {}
    local function scan(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = obj.Name:lower()
                -- Mots-clés typiques des events de collecte dans les jeux egg
                if string.find(n,"collect") or string.find(n,"pick")
                or string.find(n,"grab")   or string.find(n,"get")
                or string.find(n,"egg")    or string.find(n,"touch")
                or string.find(n,"interact") or string.find(n,"claim")
                or string.find(n,"hatch")  or string.find(n,"obtain") then
                    table.insert(remotes, obj)
                end
            end
            -- Récursif dans les dossiers
            if obj:IsA("Folder") or obj:IsA("Configuration") then
                scan(obj)
            end
        end
    end
    scan(ReplicatedStorage)
    -- Cherche aussi dans workspace (certains jeux y mettent leurs remotes)
    scan(workspace)
    return remotes
end

local CollectRemotes = ScanRemotes()

-- ================================================
-- BYPASS — MÉTHODE 1 : FIRE REMOTEEVENT DIRECT
-- ================================================

local function TryFireRemotes(egg)
    if #CollectRemotes == 0 then return false end
    local cf = GetPivot(egg)
    local pos = cf and cf.Position or Vector3.zero
    local fired = false

    for _, remote in ipairs(CollectRemotes) do
        -- Essaie plusieurs signatures d'arguments communes
        pcall(function() remote:FireServer() end)
        pcall(function() remote:FireServer(egg) end)
        pcall(function() remote:FireServer(pos) end)
        pcall(function() remote:FireServer(egg, pos) end)
        pcall(function() remote:FireServer(LocalPlayer, egg) end)
        pcall(function() remote:FireServer(true) end)
        pcall(function() remote:FireServer("collect") end)
        pcall(function() remote:FireServer("collect", egg) end)
        fired = true
    end
    return fired
end

-- ================================================
-- BYPASS — MÉTHODE 2 : SIMULATE TOUCH EVENT
-- Force un contact physique avec l'œuf via CFrame
-- ================================================

