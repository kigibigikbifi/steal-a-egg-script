-- Billboard GUI affiché au-dessus de l'œuf rare
local function AttachBillboard(egg)
    local cf = GetPivot(egg)
    if not cf then return end

    -- Part invisible ancrée à la position de l'egg
    local anchor = Instance.new("Part")
    anchor.Anchored    = true
    anchor.CanCollide  = false
    anchor.Transparency = 1
    anchor.Size        = Vector3.new(1, 1, 1)
    anchor.CFrame      = cf + Vector3.new(0, 6, 0)
    anchor.Parent      = workspace

    local bg = Instance.new("BillboardGui")
    bg.Adornee         = anchor
    bg.Size            = UDim2.new(0, 200, 0, 60)
    bg.StudsOffset     = Vector3.new(0, 2, 0)
    bg.AlwaysOnTop     = true
    bg.Parent          = anchor

    local frame = Instance.new("Frame")
    frame.Size            = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    frame.BackgroundTransparency = 0.2
    frame.Parent          = bg
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Size             = UDim2.new(1, -8, 1, -8)
    label.Position         = UDim2.new(0, 4, 0, 4)
    label.BackgroundTransparency = 1
    label.TextColor3       = Color3.fromRGB(255, 255, 255)
    label.TextScaled       = true
    label.Font             = Enum.Font.GothamBold
    label.Text             = "⚠ " .. egg.Name .. " SPAWNÉ !"
    label.Parent           = frame

    -- Auto-destroy après 15 secondes ou si l'egg disparaît
    task.spawn(function()
        task.wait(15)
        if anchor and anchor.Parent then
            anchor:Destroy()
        end
    end)

    -- Détruit aussi le billboard si l'egg est collecté
    egg.AncestryChanged:Connect(function()
        if anchor and anchor.Parent then
            anchor:Destroy()
        end
    end)
end

-- Notification Roblox native en haut à droite
local function ShowRobloxNotif(eggName)
    local StarterGui = game:GetService("StarterGui")
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title    = "⚠ ŒOEUF RARE SPAWNÉ",
            Text     = eggName .. " est apparu !",
            Duration = 10,
        })
    end)
end

-- Highlight rouge vif sur l'egg rare
local function HighlightRareEgg(egg)
    -- Supprime l'ancien si présent
    for _, c in ipairs(egg:GetChildren()) do
        if c:IsA("Highlight") and c.Name == "AXM_RARE" then c:Destroy() end
    end
    if egg:IsA("Model") then
        for _, part in ipairs(egg:GetDescendants()) do
            if part:IsA("BasePart") then
                local existing = part:FindFirstChild("AXM_RARE")
                if existing then existing:Destroy() end
            end
        end
    end

    local h = Instance.new("Highlight")
    h.Name              = "AXM_RARE"
    h.Adornee           = egg
    h.FillColor         = Color3.fromRGB(255, 0, 0)
    h.OutlineColor      = Color3.fromRGB(255, 255, 0)
    h.FillTransparency  = 0.2
    h.OutlineTransparency = 0
    h.DepthMode         = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent            = egg
end

-- Handler principal sur spawn d'un objet
local function OnDescendantAdded(obj)
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return end
    if KnownEggs[obj] then return end

    local name = obj.Name
    if not IsEgg(name) then return end
    if not IsRare(name) then return end

    -- Évite les doublons (Model + ses BasePart enfants)
    KnownEggs[obj] = true

    -- Tâche asynchrone pour ne pas bloquer le watcher
    task.spawn(function()
        task.wait(0.1)  -- Laisse l'objet se finaliser dans le monde

        print(string.format("[AXM ALERTE] Œuf rare détecté : %s", name))

        -- Son d'alerte
        PlayAlertSound()

        -- Notification Roblox
        ShowRobloxNotif(name)

        -- Highlight rouge
        pcall(HighlightRareEgg, obj)

        -- Billboard au-dessus de l'egg
        pcall(AttachBillboard, obj)

        -- Téléportation automatique si activée
        if State.AutoTeleport then
            local cf = GetPivot(obj)
            if cf then
                TeleportTo(cf)
                print(string.format("[AXM] Téléporté sur %s.", name))
            end
        end
    end)
end

-- ================================================
-- WATCHER — DÉMARRE LA SURVEILLANCE
-- ================================================

local SpawnWatcherConn = nil

local function StartSpawnWatcher()
    if SpawnWatcherConn then return end

    -- Scan initial — eggs déjà présents au lancement
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model"))
           and IsEgg(obj.Name) and IsRare(obj.Name) then
            KnownEggs[obj] = true
            pcall(HighlightRareEgg, obj)
        end
    end

    SpawnWatcherConn = workspace.DescendantAdded:Connect(OnDescendantAdded)
    print("[AXM] Spawn watcher actif.")
end

local function StopSpawnWatcher()
    if SpawnWatcherConn then
        SpawnWatcherConn:Disconnect()
        SpawnWatcherConn = nil
    end
    KnownEggs = {}
    print("[AXM] Spawn watcher arrêté.")
end

