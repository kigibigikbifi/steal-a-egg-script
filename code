local function ApplyNoFog(on)
    local L = game:GetService("Lighting")
    if on then
        for _, e in ipairs(L:GetChildren()) do
            if e:IsA("FogEffect") or e:IsA("Atmosphere") then
                e.Enabled = false
            end
        end
        L.FogEnd = 100000; L.FogStart = 99999
    else
        L.FogEnd = 100000; L.FogStart = 0
    end
end

