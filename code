-- ================================================
-- STEAL AN EGG HUB — v5 (BOUCLE COMPLÈTE & INPUTS)
-- ================================================

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Players         = game:GetService("Players")
local RunService      = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

-- ================================================
-- ÉTAT GLOBAL
-- ================================================

local State = {
    WalkSpeed     = 16,
    InfJump       = false,
    NoClip        = false,
    AutoFarmLoop  = false,
    EggType       = "All",
    -- Coordonnées personnalisées
    StartPos      = nil,
    FarmZonePos   = nil,
    SellPos       = nil,
}

local Connections    = {}
local WalkSpeedConn  = nil
local AutoFarmThread = nil
local NoClipConn     = nil

-- ================================================
-- UTILITAIRES & FIX WALK=& BYPASS
-- ================================================

local function GetCharacter()
    return LocalPlayer.Character
end

local function GetHumanoid()
    local c = GetCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function GetHRP()
    local c = GetCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Notify(title, msg, duration)
    Rayfield:Notify({ Title = title, Content = msg, Duration = duration or 3, Image = 4483362458 })
end

local function ApplyWalkSpeed(v)
    local h = GetHumanoid()
    if h then h.WalkSpeed = v end
    
    if WalkSpeedConn then WalkSpeedConn:Disconnect() end
    WalkSpeedConn = RunService.Heartbeat:Connect(function()
        local humanoid = GetHumanoid()
        if humanoid and humanoid.WalkSpeed ~= State.WalkSpeed then
            humanoid.WalkSpeed = State.WalkSpeed
        end
    end)
    table.insert(Connections, WalkSpeedConn)
end

local function BypassFire(instance)
    if not instance then return end
    
    local cd = instance:FindFirstChildOfClass("ClickDetector") or (instance:IsA("Model") and instance:FindFirstChild("ClickDetector", true))
    if cd then pcall(function() fireclickdetector(cd) end) end

    local pp = instance:FindFirstChildOfClass("ProximityPrompt") or (instance:IsA("Model") and instance:FindFirstChild("ProximityPrompt", true))
    if pp then
        pcall(function()
            pp.HoldDuration = 0
            pp.MaxActivationDistance = math.huge
            fireproximityprompt(pp)
        end)
    end

    local touchPart = instance:IsA("BasePart") and instance or (instance:IsA("Model") and (instance.PrimaryPart or instance:FindFirstChildOfClass("BasePart")))
    local hrp = GetHRP()
    if touchPart and hrp then
        pcall(function()
            local touch = touchPart:FindFirstChildOfClass("TouchTransmitter") or touchPart:FindFirstChild("TouchInterest")
            if touch then
                firetouchinterest(hrp, touchPart, 0)
                task.wait()
                firetouchinterest(hrp, touchPart, 1)
            end
        end)
    end
end

local EGG_KEYWORDS  = {"egg","oeuf","coin","reward","drop"}

local function MatchKeywords(name, keywords)
    local lowerName = string.lower(name)
    for _, kw in ipairs(keywords) do
        if string.find(lowerName, string.lower(kw), 1, true) then return true end
    end
    return false
end

local function GetPivot(obj)
    if obj:IsA("Model") then
        local ok, cf = pcall(function() return obj:GetPivot() end)
        if ok then return cf.Position end
        local p = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
        return p and p.Position or nil
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

-- Déplacement à pied vers une position
local function WalkToPosition(targetPos)
    local humanoid = GetHumanoid()
    local hrp = GetHRP()
    if not humanoid or not hrp or not targetPos then return end

    humanoid:MoveTo(targetPos)
    
    local startTime = tick()
    repeat
        task.wait(0.2)
        if not State.AutoFarmLoop then break end
        local dist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
        if dist < 4 then break end
    until tick() - startTime > 12
end

local function FindEggNear(targetPos, maxDist)
    local bestEgg = nil
    local bestPos = nil
    local shortestDist = maxDist or 50

    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and MatchKeywords(obj.Name, EGG_KEYWORDS) then
            local pos = GetPivot(obj)
            if pos then
                if State.EggType == "All" or string.find(string.lower(obj.Name), string.lower(State.EggType), 1, true) then
                    local dist = (targetPos - pos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        bestEgg = obj
                        bestPos = pos
                    end
                end
            end
        end
    end
    return bestEgg, bestPos
end

-- ================================================
-- BOUCLE PRINCIPALE AUTO FARM (Aller -> Récupérer -> Retour)
-- ================================================

local function StartAutoFarmLoop()
    if AutoFarmThread then return end
    
    if not State.StartPos then
        local hrp = GetHRP()
        if hrp then State.StartPos = hrp.Position else Notify("Erreur", "Position de départ introuvable.", 3) return end
    end
    
    if not State.FarmZonePos then
        Notify("Attention", "Veuillez définir une zone de farm d'abord !", 3)
        State.AutoFarmLoop = false
        return
    end

    AutoFarmThread = task.spawn(function()
        Notify("Auto-Farm", "Démarrage de la boucle de farm...", 2)
        
        while State.AutoFarmLoop do
            -- Étape 1 : Aller dans la zone de farm choisie
            Notify("Auto-Farm", "Déplacement vers la zone...", 2)
            WalkToPosition(State.FarmZonePos)
            task.wait(0.5)
            if not State.AutoFarmLoop then break end

            -- Étape 2 : Chercher et récupérer l'œuf dans la zone
            local hrp = GetHRP()
            if hrp then
                local eggObj, eggPos = FindEggNear(hrp.Position, 40)
                if eggObj and eggPos then
                    WalkToPosition(eggPos)
                    task.wait(0.2)
                    BypassFire(eggObj)
                    Notify("Auto-Farm", "Œuf récupéré !", 2)
                    task.wait(0.3)
                else
                    Notify("Auto-Farm", "Aucun œuf trouvé dans cette zone pour l'instant.", 2)
                    task.wait(1)
                end
            end

            -- Étape 3 : Retourner au point de départ
            if not State.AutoFarmLoop then break end
            Notify("Auto-Farm", "Retour au point de départ...", 2)
            WalkToPosition(State.StartPos)
            task.wait(1)
        end
        AutoFarmThread = nil
    end)
end

local function StopAutoFarmLoop()
    State.AutoFarmLoop = false
    AutoFarmThread = nil
    Notify("Auto-Farm", "Boucle arrêtée.", 2)
end

-- ================================================
-- MOUVEMENT (INF JUMP & NOCLIP)
-- ================================================

local function StartInfJump()
    local conn = UserInputService.JumpRequest:Connect(function()
        if not State.InfJump then return end
        local h = GetHumanoid()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
    table.insert(Connections, conn)
end

local function StartNoClip()
    NoClipConn = RunService.Stepped:Connect(function()
        if not State.NoClip then return end
        local c = GetCharacter()
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end

