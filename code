local function PlayAlertSound()
    if not State.AlertSound then return end
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://9118788073"
    s.Volume  = 1
    s.Parent  = workspace
    s:Play()
    Debris:AddItem(s, 5)
end

local function AttachBillboard(egg)
    local cf = GetPivot(egg)
    if not cf then return end

    local anchor = Instance.new("Part")
    anchor.Anchored     = true
    anchor.CanCollide   = false
    anchor.Transparency = 1
    anchor.Size         = Vector3.new(1, 1, 1)
    anchor.CFrame       = cf + Vector3.new(0, 7, 0)
    anchor.Parent       = workspace

    local bg = Instance.new("BillboardGui")
    bg.Adornee     = anchor
    bg.Size        = UDim2.new(0, 220, 0, 60)
    bg.StudsOffset = Vector3.new(0, 2, 0)
    bg.AlwaysOnTop = true
    bg.Parent      = anchor

    local frame = Instance.new("Frame")
    frame.Size                  = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3      = Color3.fromRGB(220, 30, 30)
    frame.BackgroundTransparency = 0.1
    frame.Parent                = bg
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Size                  = UDim2.new(1, -8, 1, -8)
    label.Position              = UDim2.new(0, 4, 0, 4)
    label.BackgroundTransparency = 1
    label.TextColor3            = Color3.fromRGB(255, 255, 255)
    label.TextScaled            = true
    label.Font                  = Enum.Font.GothamBold
    label.Text                  = "⚠ " .. egg.Name
    label.Parent                = frame

    -- Auto-destroy 15s ou si l'egg disparaît
    task.spawn(function() task.wait(15); if anchor.Parent then anchor:Destroy() end end)
    egg.AncestryChanged:Connect(function()
        if anchor and anchor.Parent then anchor:Destroy() end
    end)
end

local function HighlightRare(egg)
    local h = Instance.new("Highlight")
    h.Name                = "AXM_RARE"
    h.Adornee             = egg
    h.FillColor           = Color3.fromRGB(255, 0, 0)
    h.OutlineColor        = Color3.fromRGB(255, 220, 0)
    h.FillTransparency    = 0.15
    h.OutlineTransparency = 0
    h.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent              = egg
end

local function OnRareSpawn(egg)
    if KnownRares[egg] then return end
    KnownRares[egg] = true

    task.spawn(function()
        task.wait(0.1)
        print(string.format("[AXM ALERTE] %s spawné !", egg.Name))
        PlayAlertSound()
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title    = "⚠ RARE SPAWNÉ",
                Text     = egg.Name .. " est apparu — téléportation !",
                Duration = 10,
            })
        end)
        pcall(HighlightRare, egg)
        pcall(AttachBillboard, egg)
        if State.AutoTeleport then
            local cf = GetPivot(egg)
            if cf then TeleportTo(cf) end
        end
    end)
end

local function StartSpawnWatcher()
    if SpawnWatcherConn then return end
    -- Scan initial
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model"))
           and MatchAny(obj.Name, EGG_KW)
           and MatchAny(obj.Name, RARE_KW) then
            KnownRares[obj] = true
            pcall(HighlightRare, obj)
        end
    end
    SpawnWatcherConn = workspace.DescendantAdded:Connect(function(obj)
        if not State.SpawnAlert then return end
        if not (obj:IsA("BasePart") or obj:IsA("Model")) then return end
        if MatchAny(obj.Name, EGG_KW) and MatchAny(obj.Name, RARE_KW) then
            OnRareSpawn(obj)
        end
    end)
    print("[AXM] Spawn watcher actif.")
end

local function StopSpawnWatcher()
    if SpawnWatcherConn then SpawnWatcherConn:Disconnect(); SpawnWatcherConn = nil end
    KnownRares = {}
end

