-- ====================================================================
-- KEYWORDS
-- ====================================================================

local EGG_KW  = {"Egg","egg","EGG","oeuf","Oeuf"}
local SELL_KW = {"Sell","sell","SELL","Shop","shop","Vendor","vendor","NPC","npc"}
local ITEM_KW = {"collectible","Collectible","pickup","Pickup","item","Item","drop","Drop","coin","Coin"}
local RARE_KW = {
    "Eternal","eternal","ETERNAL",
    "Secret","secret","SECRET",
    "Mythic","mythic","MYTHIC",
    "Divine","divine","DIVINE",
    "Celestial","celestial",
    "Omega","omega",
    "Ultra","ultra",
    "Godly","godly",
}

local function MatchAny(name, keywords)
    for _, kw in ipairs(keywords) do
        if string.find(name, kw, 1, true) then return true end
    end
    return false
end

-- ====================================================================
-- UTILITAIRES PERSONNAGE
-- ====================================================================

local function GetChar()       return LocalPlayer.Character end
local function GetHumanoid()   local c=GetChar(); return c and c:FindFirstChildOfClass("Humanoid") end
local function GetHRP()        local c=GetChar(); return c and c:FindFirstChild("HumanoidRootPart") end

local function GetPivot(obj)
    if obj:IsA("Model") then
        local ok, cf = pcall(function() return obj:GetPivot() end)
        if ok and cf then return cf end
        local p = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
        return p and p.CFrame or nil
    elseif obj:IsA("BasePart") then
        return obj.CFrame
    end
    return nil
end

local function TeleportTo(cf)
    local hrp = GetHRP()
    if hrp and cf then
        hrp.CFrame = CFrame.new(cf.Position + Vector3.new(0, 4, 0))
    end
end

local function Notify(title, msg, duration)
    Rayfield:Notify({ Title = title, Content = msg, Duration = duration or 3, Image = 4483362458 })
end

-- ====================================================================
-- UTILITAIRES WORKSPACE
-- ====================================================================

local function GetObjectsByKeywords(keywords, typeFilter)
    local results = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            if MatchAny(obj.Name, keywords) then
                if not typeFilter or typeFilter == "All"
                   or string.find(obj.Name, typeFilter, 1, true) then
                    table.insert(results, obj)
                end
            end
        end
    end
    return results
end

local function DeepFind(parent, className)
    for _, c in ipairs(parent:GetDescendants()) do
        if c:IsA(className) then return c end
    end
    return nil
end

local function NearestObject(objs)
    local hrp = GetHRP()
    if not hrp then return nil end
    local best, bestDist = nil, math.huge
    for _, obj in ipairs(objs) do
        local cf = GetPivot(obj)
        if cf then
            local d = (hrp.Position - cf.Position).Magnitude
            if d < bestDist then bestDist = d; best = obj end
        end
    end
    return best, bestDist
end

-- ====================================================================
-- SCAN REMOTEEVENTS DE COLLECTE
-- ====================================================================

local CollectRemotes = {}

local function ScanRemotes()
    local found = {}
    local collect_kw = {"collect","pick","grab","get","egg","touch","interact","claim","hatch","obtain"}
    local function scan(parent)
        for _, obj in ipairs(parent:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = obj.Name:lower()
                for _, kw in ipairs(collect_kw) do
                    if string.find(n, kw, 1, true) then
                        table.insert(found, obj)
                        break
                    end
                end
            end
        end
    end
    scan(ReplicatedStorage)
    scan(workspace)
    return found
end

CollectRemotes = ScanRemotes()

-- ====================================================================
-- BYPASS — 4 MÉTHODES DE COLLECTE
-- ====================================================================

local function BypassRemote(egg)
    if #CollectRemotes == 0 then return end
    local cf  = GetPivot(egg)
    local pos = cf and cf.Position or Vector3.zero
    for _, r in ipairs(CollectRemotes) do
        pcall(function() r:FireServer() end)
        pcall(function() r:FireServer(egg) end)
        pcall(function() r:FireServer(pos) end)
        pcall(function() r:FireServer(egg, pos) end)
        pcall(function() r:FireServer(LocalPlayer, egg) end)
        pcall(function() r:FireServer(true) end)
        pcall(function() r:FireServer("collect") end)
        pcall(function() r:FireServer("collect", egg) end)
    end
end

local function BypassTouch(egg)
    local hrp = GetHRP()
    if not hrp then return end
    local cf = GetPivot(egg)
    if not cf then return end
    hrp.CFrame = cf
    task.wait(0.05)
end

local function BypassClick(egg)
    local cd = DeepFind(egg, "ClickDetector")
    if cd then
        local orig = cd.MaxActivationDistance
        cd.MaxActivationDistance = 9999
        pcall(function() fireclickdetector(cd, 0) end)
        task.wait(0.02)
        pcall(function() cd.MaxActivationDistance = orig end)
        return true
    end
    local pp = DeepFind(egg, "ProximityPrompt")
    if pp then
        local orig = pp.MaxActivationDistance
        pp.MaxActivationDistance = 9999
        pp.RequiresLineOfSight   = false
        pcall(function() fireproximityprompt(pp) end)
        task.wait(0.02)
        pcall(function()
            pp.MaxActivationDistance = orig
            pp.RequiresLineOfSight   = true
        end)
        return true
    end
    return false
end

local function BypassBindable(egg)
    local bindable_kw = {"collect","pick","grab","egg","touch","interact"}
    for _, c in ipairs(egg:GetDescendants()) do
        if c:IsA("BindableEvent") or c:IsA("BindableFunction") then
            local n = c.Name:lower()
            for _, kw in ipairs(bindable_kw) do
                if string.find(n, kw, 1, true) then
                    pcall(function() c:Fire() end)
                    pcall(function() c:Fire(egg) end)
                    break
                end
            end
        end
    end
end

local function CollectEgg(egg)
    local cf = GetPivot(egg)
    if cf then TeleportTo(cf) end
    task.wait(0.05)
    BypassRemote(egg)
    BypassTouch(egg)
    BypassClick(egg)
    BypassBindable(egg)
    -- Remonte sur le Model parent si l'egg est une BasePart enfant
    if egg:IsA("BasePart") and egg.Parent and egg.Parent:IsA("Model") then
        BypassRemote(egg.Parent)
        BypassClick(egg.Parent)
    end
end

-- ====================================================================
-- MOUVEMENT
-- ====================================================================

local function ApplyWalkSpeed(v)
    local h = GetHumanoid()
    if h then h.WalkSpeed = v end
end

local function StartInfJump()
    local conn = UserInputService.JumpRequest:Connect(function()
        if not State.InfJump then return end
        local h = GetHumanoid()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
    table.insert(Connections, conn)
end

local function StartNoClip()
    if NoClipConn then NoClipConn:Disconnect() end
    NoClipConn = RunService.Stepped:Connect(function()
        if not State.NoClip then return end
        local c = GetChar()
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end

-- ====================================================================
-- GODMODE — INVINCIBILITÉ
-- ====================================================================

local function StartGodmode()
    local hum = GetHumanoid()
    if not hum then return end

    -- Méthode 1 : HealthChanged — réaction instantanée
    if GodmodeConn then GodmodeConn:Disconnect() end
    GodmodeConn = hum.HealthChanged:Connect(function(hp)
        if State.Godmode and hp < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
    end)

    -- Méthode 2 : loop 60Hz — couvre les dégâts serveur inter-frame
    task.spawn(function()
        while State.Godmode do
            local h = GetHumanoid()
            if h then
                h.MaxHealth = math.huge
                h.Health    = math.huge
            end
            task.wait(0.016)
        end
    end)
end

local function StopGodmode()
    State.Godmode = false
    if GodmodeConn then GodmodeConn:Disconnect(); GodmodeConn = nil end
    local h = GetHumanoid()
    if h then
        h.MaxHealth = State.CustomMaxHP
        h.Health    = State.CustomMaxHP
    end
end

-- ====================================================================
-- AUTO FARM
-- ====================================================================

local function StartAutoFarm()
    if FarmThread then return end
    FarmThread = task.spawn(function()
        while State.AutoFarm do
            local eggs = GetObjectsByKeywords(EGG_KW, State.EggType)
            if #eggs == 0 then
                task.wait(0.5)
            else
                for _, egg in ipairs(eggs) do
                    if not State.AutoFarm then break end
                    pcall(CollectEgg, egg)
                    task.wait(State.FarmDelay)
                end
            end
            task.wait(0.1)
        end
        FarmThread = nil
    end)
end

-- ====================================================================
-- AUTO SELL
-- ====================================================================

local function StartAutoSell()
    if SellThread then return end
    SellThread = task.spawn(function()
        while State.AutoSell do
            local pts = GetObjectsByKeywords(SELL_KW)
            for _, sp in ipairs(pts) do
                if not State.AutoSell then break end
                local cf = GetPivot(sp)
                if cf then
                    TeleportTo(cf)
                    task.wait(0.2)
                    BypassClick(sp)
                    BypassRemote(sp)
                end
            end
            task.wait(2)
        end
        SellThread = nil
    end)
end

-- ====================================================================
-- AUTO HATCH
-- ====================================================================

local function StartAutoHatch()
    if HatchThread then return end
    HatchThread = task.spawn(function()
        while State.AutoHatch do
            for _, obj in ipairs(workspace:GetDescendants()) do
                if not State.AutoHatch then break end
                if (obj:IsA("BasePart") or obj:IsA("Model"))
                   and (string.find(obj.Name,"Hatch",1,true)
                     or string.find(obj.Name,"hatch",1,true)) then
                    local cf = GetPivot(obj)
                    if cf then
                        TeleportTo(cf)
                        task.wait(0.15)
                        BypassClick(obj)
                        BypassRemote(obj)
                    end
                end
            end
            task.wait(1)
        end
        HatchThread = nil
    end)
end

