-- ================================================
-- COMBAT — AIMBOT
-- ================================================

local function GetNearestPlayer()
    local hrp  = GetHRP()
    if not hrp then return nil end
    local best, bestDist = nil, State.AimbotRange

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local th = p.Character:FindFirstChild("HumanoidRootPart")
            local hm = p.Character:FindFirstChildOfClass("Humanoid")
            if th and hm and hm.Health > 0 then
                local dist = (hrp.Position - th.Position).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    best = th
                end
            end
        end
    end
    return best
end

local function StartAimbot()
    if AimbotThread then return end
    AimbotThread = task.spawn(function()
        while State.AimbotOn do
            local target = GetNearestPlayer()
            if target then
                local camera = workspace.CurrentCamera
                camera.CFrame = CFrame.new(camera.CFrame.Position, target.Position)
            end
            task.wait(0.016)  -- ~60Hz
        end
        AimbotThread = nil
    end)
end

-- ================================================
-- ESP — SYSTÈME DE SURBRILLANCE
-- ================================================

local function ClearESP()
    if ESPFolder then
        ESPFolder:Destroy()
        ESPFolder = nil
    end
end

local function MakeHighlight(adornee, fillColor, outlineColor)
    if not ESPFolder then return end
    -- Évite les doublons
    for _, h in ipairs(ESPFolder:GetChildren()) do
        if h:IsA("Highlight") and h.Adornee == adornee then return end
    end
    local h = Instance.new("Highlight")
    h.Adornee             = adornee
    h.FillColor           = fillColor
    h.OutlineColor        = outlineColor
    h.FillTransparency    = 0.5
    h.OutlineTransparency = 0
    h.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent              = ESPFolder
end

local function BuildESP()
    ClearESP()
    ESPFolder = Instance.new("Folder")
    ESPFolder.Name   = "AXM_ESP"
    ESPFolder.Parent = workspace

    -- Joueurs
    if State.ESPPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                MakeHighlight(p.Character, Color3.fromRGB(255, 80, 80), Color3.fromRGB(255, 255, 255))
            end
        end
        -- Nouveaux joueurs en cours de partie
        local c1 = Players.PlayerAdded:Connect(function(p)
            p.CharacterAdded:Connect(function(char)
                task.wait(0.5)
                if State.ESPPlayers and ESPFolder then
                    MakeHighlight(char, Color3.fromRGB(255, 80, 80), Color3.fromRGB(255, 255, 255))
                end
            end)
        end)
        table.insert(Connections, c1)
    end

    -- Eggs
    if State.ESPEggs then
        for _, obj in ipairs(GetEggsInWorkspace()) do
            MakeHighlight(obj, Color3.fromRGB(255, 220, 50), Color3.fromRGB(255, 255, 255))
        end
        local c2 = workspace.DescendantAdded:Connect(function(obj)
            if not State.ESPEggs or not ESPFolder then return end
            if (obj:IsA("BasePart") or obj:IsA("Model")) and MatchKeywords(obj.Name, EGG_KEYWORDS) then
                task.wait(0.1)
                MakeHighlight(obj, Color3.fromRGB(255, 220, 50), Color3.fromRGB(255, 255, 255))
            end
        end)
        table.insert(Connections, c2)
    end

    -- Items divers
    if State.ESPItems then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if (obj:IsA("BasePart") or obj:IsA("Model")) and MatchKeywords(obj.Name, ITEM_KEYWORDS) then
                MakeHighlight(obj, Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 255, 255))
            end
        end
    end
end

local function RefreshESP()
    ClearConnections()
    if State.ESPPlayers or State.ESPEggs or State.ESPItems then
        BuildESP()
    else
        ClearESP()
    end
end

