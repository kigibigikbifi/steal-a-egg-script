-- EGG — FARM AUTOMATIQUE
-- ================================================

local function StopAutoFarm()
    State.AutoFarm = false
    AutoFarmThread = nil
end

local function StartAutoFarm()
    if AutoFarmThread then return end
    AutoFarmThread = task.spawn(function()
        while State.AutoFarm do
            local eggs = GetEggsInWorkspace()
            for _, egg in ipairs(eggs) do
                if not State.AutoFarm then break end
                local cf = GetPivot(egg)
                if cf then
                    TeleportTo(cf)
                    task.wait(0.15)

                    -- Interaction ClickDetector
                    local cd = egg:FindFirstChildOfClass("ClickDetector")
                        or (egg:IsA("Model") and egg:FindFirstChild("ClickDetector", true))
                    if cd then fireclickdetector(cd) end

                    -- Interaction ProximityPrompt
                    local pp = egg:FindFirstChildOfClass("ProximityPrompt")
                        or (egg:IsA("Model") and egg:FindFirstChild("ProximityPrompt", true))
                    if pp then fireproximityprompt(pp) end

                    task.wait(0.1)
                end
            end
            task.wait(0.5)
        end
        AutoFarmThread = nil
    end)
end

