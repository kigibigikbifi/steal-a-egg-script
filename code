        if hrp then
            State.FarmZonePos = hrp.Position
            Notify("Zone de Farm", "Votre position actuelle a été définie comme zone de farm !", 3)
        end
    end,
})

TabFarm:CreateToggle({
    Name = "3. Activer l'Auto Farm (Aller -> Récupérer -> Retour)", CurrentValue = false, Flag = "AutoFarmLoop",
    Callback = function(v)
        State.AutoFarmLoop = v
        if v then
            StartAutoFarmLoop()
        else
