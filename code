    -- Laisse le moteur physique enregistrer le touch
    task.wait(0.05)

    -- Retourne à la position originale si AutoFarm est encore actif
    -- (sinon on reste sur l'egg pour la téléportation manuelle)
    if State.AutoFarm then
        -- On reste en place, la boucle gère le déplacement
    end
end

-- ================================================
-- BYPASS — MÉTHODE 3 : CLICKDETECTOR AVEC DISTANCE BYPASS
-- Ignore la MaxActivationDistance du ClickDetector
-- ================================================

local function TryClickBypass(egg)
    local function deepFind(parent, className)
        for _, c in ipairs(parent:GetDescendants()) do
            if c:IsA(className) then return c end
        end
        return nil
    end

    local cd = deepFind(egg, "ClickDetector")
    if cd then
        -- Override temporaire de la distance max
        local originalDist = cd.MaxActivationDistance
        cd.MaxActivationDistance = 9999
        pcall(function() fireclickdetector(cd, 0) end)
        task.wait(0.02)
        pcall(function() cd.MaxActivationDistance = originalDist end)
        return true
    end

    local pp = deepFind(egg, "ProximityPrompt")
    if pp then
        local originalDist = pp.MaxActivationDistance
        pp.MaxActivationDistance = 9999
        pp.RequiresLineOfSight = false
        pcall(function() fireproximityprompt(pp) end)
        task.wait(0.02)
        pcall(function()
            pp.MaxActivationDistance = originalDist
            pp.RequiresLineOfSight = true
        end)
        return true
    end

    return false
end

-- ================================================
-- BYPASS — MÉTHODE 4 : SCRIPT SIGNAL / BINDABLE
-- Certains jeux utilisent des BindableEvents internes
-- ================================================

local function TryBindableBypass(egg)
    local function findBindable(parent)
        for _, c in ipairs(parent:GetDescendants()) do
            if c:IsA("BindableEvent") or c:IsA("BindableFunction") then
                local n = c.Name:lower()
                if string.find(n,"collect") or string.find(n,"pick")
                or string.find(n,"grab")   or string.find(n,"egg")
                or string.find(n,"touch")  or string.find(n,"interact") then
                    return c
                end
            end
        end
        return nil
    end

    local be = findBindable(egg)
    if be then
        pcall(function() be:Fire() end)
        pcall(function() be:Fire(egg) end)
        return true
    end
    return false
end

-- ================================================
-- COLLECTE COMPLÈTE — ENCHAÎNE TOUTES LES MÉTHODES
-- ================================================

local function CollectEgg(egg)
    -- Téléporte d'abord sur l'œuf
    local cf = GetPivot(egg)
    if cf then TeleportTo(cf) end
    task.wait(0.05)

    -- Méthode 1 : RemoteEvent direct
    TryFireRemotes(egg)

    -- Méthode 2 : Touch physique
    TryTouchBypass(egg)

    -- Méthode 3 : ClickDetector distance bypass
    TryClickBypass(egg)

    -- Méthode 4 : BindableEvent
    TryBindableBypass(egg)

    -- Dernier recours : tentative générique sur le parent Model
    if egg:IsA("BasePart") and egg.Parent:IsA("Model") then
        CollectEgg(egg.Parent)  -- Recommence sur le Model parent
    end
end

-- ================================================
-- AUTO FARM LOOP
-- ================================================

local function GetEggsInWorkspace()
    local results = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            if IsEgg(obj.Name) then
                if State.EggType == "All" or string.find(obj.Name, State.EggType, 1, true) then
                    table.insert(results, obj)
                end
            end
        end
    end
    return results
end

local function StartAutoFarm()
    if FarmThread then return end
    FarmThread = task.spawn(function()
        while State.AutoFarm do
            local eggs = GetEggsInWorkspace()
            if #eggs == 0 then
                task.wait(0.5)
            else
                for _, egg in ipairs(eggs) do
                    if not State.AutoFarm then break end
                    pcall(CollectEgg, egg)
                    task.wait(State.FarmDelay)
                end
            end
            task.wait(0.1)
        end
        FarmThread = nil
    end)
end

local function StopAutoFarm()
    State.AutoFarm = false
    FarmThread = nil
end

