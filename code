local Mouse = LocalPlayer:GetMouse()

local function StartAutoClick()
    if AutoClickThread then return end
    AutoClickThread = task.spawn(function()
        while State.AutoClick do
            local target = Mouse.Target
            if target then
                local cd = target:FindFirstChildOfClass("ClickDetector")
                if cd then fireclickdetector(cd) end
                local pp = target:FindFirstChildOfClass("ProximityPrompt")
                if pp then fireproximityprompt(pp) end
            end
            task.wait(1 / State.AutoClickCPS)
        end
        AutoClickThread = nil
    end)
end

-- ====================================================================
-- COMBAT — AIMBOT
-- ====================================================================

local function GetNearestPlayer()
    local hrp = GetHRP()
    if not hrp then return nil end
    local best, bestDist = nil, State.AimbotRange
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local th = p.Character:FindFirstChild("HumanoidRootPart")
            local hm = p.Character:FindFirstChildOfClass("Humanoid")
            if th and hm and hm.Health > 0 then
                local d = (hrp.Position - th.Position).Magnitude
                if d < bestDist then bestDist = d; best = th end
            end
        end
    end
    return best
end

local function StartAimbot()
    if AimbotThread then return end
    AimbotThread = task.spawn(function()
        while State.AimbotOn do
            local t = GetNearestPlayer()
            if t then
                workspace.CurrentCamera.CFrame =
                    CFrame.new(workspace.CurrentCamera.CFrame.Position, t.Position)
            end
            task.wait(0.016)
        end
        AimbotThread = nil
    end)
end

-- ====================================================================
-- ESP
-- ====================================================================

local function ClearESP()
    if ESPFolder then ESPFolder:Destroy(); ESPFolder = nil end
end

local function MakeHighlight(adornee, fill, outline)
    if not ESPFolder then return end
    for _, h in ipairs(ESPFolder:GetChildren()) do
        if h:IsA("Highlight") and h.Adornee == adornee then return end
    end
    local h = Instance.new("Highlight")
    h.Adornee             = adornee
    h.FillColor           = fill
    h.OutlineColor        = outline
    h.FillTransparency    = 0.5
    h.OutlineTransparency = 0
    h.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent              = ESPFolder
end

local function BuildESP()
    ClearESP()
    for _, c in ipairs(Connections) do if c then c:Disconnect() end end
    Connections = {}

    ESPFolder        = Instance.new("Folder")
    ESPFolder.Name   = "AXM_ESP"
    ESPFolder.Parent = workspace

    if State.ESPPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                MakeHighlight(p.Character,
                    Color3.fromRGB(255,80,80), Color3.fromRGB(255,255,255))
            end
        end
        table.insert(Connections, Players.PlayerAdded:Connect(function(p)
            p.CharacterAdded:Connect(function(char)
                task.wait(0.5)
                if State.ESPPlayers and ESPFolder then
                    MakeHighlight(char,
                        Color3.fromRGB(255,80,80), Color3.fromRGB(255,255,255))
                end
            end)
        end))
    end

    if State.ESPEggs then
        for _, obj in ipairs(GetObjectsByKeywords(EGG_KW, State.EggType)) do
            MakeHighlight(obj,
                Color3.fromRGB(255,220,50), Color3.fromRGB(255,255,255))
        end
        table.insert(Connections, workspace.DescendantAdded:Connect(function(obj)
            if not State.ESPEggs or not ESPFolder then return end
            if (obj:IsA("BasePart") or obj:IsA("Model"))
               and MatchAny(obj.Name, EGG_KW) then
                task.wait(0.1)
                MakeHighlight(obj,
                    Color3.fromRGB(255,220,50), Color3.fromRGB(255,255,255))
            end
        end))
    end

    if State.ESPItems then
        for _, obj in ipairs(GetObjectsByKeywords(ITEM_KW)) do
            MakeHighlight(obj,
                Color3.fromRGB(80,200,255), Color3.fromRGB(255,255,255))
        end
    end
end

