-- ================================================
-- UTILITAIRES & FIX WALK=& BYPASS
-- ================================================

local function GetCharacter()
    return LocalPlayer.Character
end

local function GetHumanoid()
    local c = GetCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function GetHRP()
    local c = GetCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Notify(title, msg, duration)
    Rayfield:Notify({ Title = title, Content = msg, Duration = duration or 3, Image = 4483362458 })
end

local function ClearConnections()
    for _, c in ipairs(Connections) do
        if c then c:Disconnect() end
    end
    Connections = {}
end

-- Correction Anti-Cheat pour forcer le WalkSpeed à chaque frame si nécessaire
local WalkSpeedConn = nil
local function ApplyWalkSpeed(v)
    local h = GetHumanoid()
    if h then h.WalkSpeed = v end
    
    if WalkSpeedConn then WalkSpeedConn:Disconnect() end
    WalkSpeedConn = RunService.Heartbeat:Connect(function()
        local humanoid = GetHumanoid()
        if humanoid and humanoid.WalkSpeed ~= State.WalkSpeed then
            humanoid.WalkSpeed = State.WalkSpeed
        end
    end)
    table.insert(Connections, WalkSpeedConn)
end

-- Bypass universel pour interagir sans se téléporter
local function BypassFire(instance)
    if not instance then return end
    
    local cd = instance:FindFirstChildOfClass("ClickDetector") or (instance:IsA("Model") and instance:FindFirstChild("ClickDetector", true))
    if cd then
        pcall(function() fireclickdetector(cd) end)
    end

    local pp = instance:FindFirstChildOfClass("ProximityPrompt") or (instance:IsA("Model") and instance:FindFirstChild("ProximityPrompt", true))
    if pp then
        pcall(function()
            pp.HoldDuration = 0
            pp.MaxActivationDistance = math.huge
            fireproximityprompt(pp)
        end)
    end

    local touchPart = instance:IsA("BasePart") and instance or (instance:IsA("Model") and (instance.PrimaryPart or instance:FindFirstChildOfClass("BasePart")))
    local hrp = GetHRP()
    if touchPart and hrp then
        pcall(function()
            local touch = touchPart:FindFirstChildOfClass("TouchTransmitter") or touchPart:FindFirstChild("TouchInterest")
            if touch then
                firetouchinterest(hrp, touchPart, 0)
                task.wait()
                firetouchinterest(hrp, touchPart, 1)
            end
        end)
    end
end

-- Mots-clés
local EGG_KEYWORDS  = {"egg","oeuf","coin","reward","drop"}
local SELL_KEYWORDS = {"sell","shop","vendor","npc","bank","exchange"}
local ITEM_KEYWORDS = {"collectible","pickup","item","drop","chest"}

local function MatchKeywords(name, keywords)
    local lowerName = string.lower(name)
    for _, kw in ipairs(keywords) do
        if string.find(lowerName, string.lower(kw), 1, true) then return true end
    end
    return false
end

local function GetPivot(obj)
    if obj:IsA("Model") then
        local ok, cf = pcall(function() return obj:GetPivot() end)
        if ok then return cf.Position end
        local p = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
        return p and p.Position or nil
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

-- Déplacement naturel en marchant (Pathfinding ou MoveTo direct)
local function WalkToPosition(targetPos)
    local humanoid = GetHumanoid()
    local hrp = GetHRP()
    if not humanoid or not hrp then return end

    humanoid:MoveTo(targetPos)
    
    -- Attendre que le perso arrive ou que le temps dépasse
    local startTime = tick()
    repeat
        task.wait(0.2)
        if not State.AutoFarm then break end
        local dist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
        if dist < 4 then break end
    until tick() - startTime > 6
end

-- Vérifie si une position est dans la zone définie par le joueur
local function IsInZone(pos)
    if not pos then return false end
    local minX = math.min(State.ZoneMin.X, State.ZoneMax.X)
    local maxX = math.max(State.ZoneMin.X, State.ZoneMax.X)
    local minZ = math.min(State.ZoneMin.Z, State.ZoneMax.Z)
    local maxZ = math.max(State.ZoneMin.Z, State.ZoneMax.Z)

    return pos.X >= minX and pos.X <= maxX and pos.Z >= minZ and pos.Z <= maxZ
end

local function GetEggsInZone()
    local results = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and MatchKeywords(obj.Name, EGG_KEYWORDS) then
            local pos = GetPivot(obj)
            if pos and IsInZone(pos) then
                if State.EggType == "All" or string.find(string.lower(obj.Name), string.lower(State.EggType), 1, true) then
                    table.insert(results, {Object = obj, Position = pos})
                end
            end
        end
    end
    return results
end

local function GetSellPoints()
    local results = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and MatchKeywords(obj.Name, SELL_KEYWORDS) then
            table.insert(results, obj)
        end
    end
    return results
end

-- ================================================
-- MOUVEMENT (INF JUMP & NOCLIP)
-- ================================================

local function StartInfJump()
    local conn = UserInputService.JumpRequest:Connect(function()
        if not State.InfJump then return end
        local h = GetHumanoid()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
    table.insert(Connections, conn)
end

local NoClipConn = nil
local function StartNoClip()
    NoClipConn = RunService.Stepped:Connect(function()
        if not State.NoClip then return end
        local c = GetCharacter()
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
    end)
end

-- ================================================
-- AUTO FARM PAR ZONE (MARCHE SANS TÉLÉPORTATION)
-- ================================================

local function StopAutoFarm()
    State.AutoFarm = false
    AutoFarmThread = nil
end

local function StartAutoFarm()
    if AutoFarmThread then return end
    AutoFarmThread = task.spawn(function()
        while State.AutoFarm do
            local eggs = GetEggsInZone()
            if #eggs > 0 then
                -- Trier par distance pour aller au plus près en marchant
                table.sort(eggs, function(a, b)
                    local hrp = GetHRP()
                    if not hrp then return false end
                    return (hrp.Position - a.Position).Magnitude < (hrp.Position - b.Position).Magnitude
                end)

                for _, eggData in ipairs(eggs) do
                    if not State.AutoFarm then break end
                    WalkToPosition(eggData.Position)
                    task.wait(0.1)
                    BypassFire(eggData.Object)
                    task.wait(0.2)
                end
            else
                -- Si aucun œuf dans la zone, patrouiller / faire des aller-retours au centre de la zone
                local midX = (State.ZoneMin.X + State.ZoneMax.X) / 2
                local midZ = (State.ZoneMin.Z + State.ZoneMax.Z) / 2
                WalkToPosition(Vector3.new(midX, GetHRP() and GetHRP().Position.Y or 0, midZ))
            end
            task.wait(0.5)
        end
        AutoFarmThread = nil
    end)
end

-- ================================================
-- AUTO VENTE (EN MARCHANT)
-- ================================================

local function StopAutoSell()
    State.AutoSell = false
    AutoSellThread = nil
end

local function StartAutoSell()
    if AutoSellThread then return end
    AutoSellThread = task.spawn(function()
        while State.AutoSell do
            local points = GetSellPoints()
            for _, sp in ipairs(points) do
                if not State.AutoSell then break end
                local pos = GetPivot(sp)
                if pos then
                    WalkToPosition(pos)
                    task.wait(0.2)
                    BypassFire(sp)
                end
            end
            task.wait(2)
        end
        AutoSellThread = nil
    end)
end

-- ================================================
-- ESP & AUTRES
-- ================================================

local function ClearESP()
    if ESPFolder then
        ESPFolder:Destroy()
        ESPFolder = nil
    end
end

local function MakeHighlight(adornee, fillColor, outlineColor)
    if not ESPFolder then return end
    for _, h in ipairs(ESPFolder:GetChildren()) do
        if h:IsA("Highlight") and h.Adornee == adornee then return end
    end
    local h = Instance.new("Highlight")
    h.Adornee             = adornee
    h.FillColor           = fillColor
    h.OutlineColor        = outlineColor
    h.FillTransparency    = 0.5
    h.OutlineTransparency = 0
    h.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent              = ESPFolder
end

local function BuildESP()
    ClearESP()
    ESPFolder = Instance.new("Folder")
    ESPFolder.Name   = "AXM_ESP"
    ESPFolder.Parent = workspace

    if State.ESPEggs then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if (obj:IsA("BasePart") or obj:IsA("Model")) and MatchKeywords(obj.Name, EGG_KEYWORDS) then
                MakeHighlight(obj, Color3.fromRGB(255, 220, 50), Color3.fromRGB(255, 255, 255))
            end
        end
    end
end

local function RefreshESP()
    ClearConnections()
    if State.ESPEggs then BuildESP() else ClearESP() end
end

