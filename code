local function GetCharacter()
    return LocalPlayer.Character
end

local function GetHumanoid()
    local c = GetCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function GetHRP()
    local c = GetCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Notify(title, msg, duration)
    Rayfield:Notify({ Title = title, Content = msg, Duration = duration or 3, Image = 4483362458 })
end

local function ClearConnections()
    for _, c in ipairs(Connections) do
        if c then c:Disconnect() end
    end
    Connections = {}
end

-- Cherche des instances par mot-clé dans workspace
local EGG_KEYWORDS  = {"egg","Egg","EGG","oeuf","Oeuf"}
local SELL_KEYWORDS = {"sell","Sell","SELL","shop","Shop","vendor","Vendor","NPC"}
local ITEM_KEYWORDS = {"collectible","Collectible","pickup","Pickup","item","Item","drop","Drop","coin","Coin"}

local function MatchKeywords(name, keywords)
    for _, kw in ipairs(keywords) do
        if string.find(name, kw, 1, true) then return true end
    end
    return false
end

local function GetEggsInWorkspace()
    local results = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and MatchKeywords(obj.Name, EGG_KEYWORDS) then
            -- Filtre par type si pas "All"
            if State.EggType == "All" or string.find(obj.Name, State.EggType, 1, true) then
                table.insert(results, obj)
            end
        end
    end
    return results
end

local function GetSellPoints()
    local results = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Part"))
           and MatchKeywords(obj.Name, SELL_KEYWORDS) then
            table.insert(results, obj)
        end
    end
    return results
end

local function GetPivot(obj)
    if obj:IsA("Model") then
        local ok, cf = pcall(function() return obj:GetPivot() end)
        if ok then return cf end
        local p = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
        return p and p.CFrame or nil
    elseif obj:IsA("BasePart") then
        return obj.CFrame
    end
    return nil
end

local function TeleportTo(cf)
    local hrp = GetHRP()
    if hrp and cf then
        hrp.CFrame = cf + Vector3.new(0, 3, 0)
    end
end

